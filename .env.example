# ============================================================
# Olmem Technical Services — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local. Production values go in Vercel:
#   Project → Settings → Environment Variables
# ============================================================

# ================================================================
# EMAIL — SMTP via Nodemailer
# ================================================================
# SMTP is the only email service. Resend is NOT used: the contact form sends
# through these settings, matching the Olmem Technical Solutions site.
#
# Gmail / Google Workspace: SMTP_PASS must be a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords), NOT the
# account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@olmemtech.com
SMTP_PASS=
SMTP_FROM=you@olmemtech.com

# Where new service requests are delivered. Comma-separate for several people.
CONTACT_TO_EMAIL=you@olmemtech.com

# ================================================================
# DATABASE — NEON POSTGRES (powers the admin lead dashboard)
# ================================================================
# The app reads ONE variable: DATABASE_URL (the POOLED connection string).
#
# ── Production (Vercel) ─────────────────────────────────────────
# Vercel → Storage → your Neon database → Connect Project, choosing the custom
# prefix DATABASE so the pooled string is injected as DATABASE_URL.
#
# ── Local development ───────────────────────────────────────────
#   npm i -g vercel && vercel link && vercel env pull .env.local
# or paste the "Pooled connection" string from the Neon dashboard.
#
# Format: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# This site's tables are prefixed ots_ (ots_leads, ots_lead_follow_ups), so it
# can safely share a Neon database with the Olmem Technical Solutions site
# without the two lead pipelines mixing. Tables are created automatically on
# first use — there is no migration step.
#
# Leave blank and the site still runs: the contact form falls back to email-only
# and the admin dashboard reports that no database is connected.
DATABASE_URL=

# ================================================================
# ADMIN DASHBOARD (/admin)
# ================================================================
# Signing key for the admin session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# The single administrator login for /admin.
ADMIN_USER=admin
ADMIN_PASS=
# Optional. Recorded as the author on lead follow-up entries.
ADMIN_EMAIL=you@olmemtech.com

# ================================================================
# APP CONFIGURATION
# ================================================================
NEXT_PUBLIC_SITE_URL=https://www.olmemtechnicalservices.com
NEXT_PUBLIC_CONTACT_EMAIL=you@olmemtech.com
